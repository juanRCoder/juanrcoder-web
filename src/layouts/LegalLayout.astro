---
import SEO from "../components/SEO.astro";
import "../styles/global.css";
import logoImage from "../assets/logo1.webp";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0D09" />
    <link rel="icon" href={logoImage.src} type="image/webp" />
    <link rel="apple-touch-icon" href={logoImage.src} />
    <SEO title={`${title} | Juanra Software`} description={description} />
  </head>
  <body class="bg-[#EFF1EA] flex flex-col min-h-screen overflow-x-hidden">
    <header class="sticky top-0 z-50 bg-[#0B0D09]/75 backdrop-blur-md w-full">
      <div class="max-w-360 mx-auto px-6 md:px-16 py-4 flex justify-between items-center">
        <a href="/" class="flex gap-2.5 items-center" aria-label="juanra software, ir al inicio">
          <Image src={logoImage} alt="" class="w-9.75 h-11 object-cover" />
          <span class="text-[18px]/[normal] text-[#A7AC9F] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold tracking-[1px]">
            juanra<br />software
          </span>
        </a>
        <a
          href="/"
          class="text-[13px] text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[0.8px] hover:underline"
        >
          ← VOLVER AL INICIO
        </a>
      </div>
    </header>

    <main class="flex-1 w-full max-w-3xl mx-auto px-6 py-12 md:py-16">
      <h1 class="text-5xl md:text-6xl text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold tracking-tight uppercase">
        {title}
      </h1>
      <p class="mt-3 text-[12px] text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.2px]">
        ÚLTIMA ACTUALIZACIÓN: {updated.toUpperCase()}
      </p>
      <div
        class="mt-10 flex flex-col gap-4 text-[16px]/[26px] text-[#2B2F26] font-['Instrument_Sans',system-ui,sans-serif] [&_h2]:mt-8 [&_h2]:text-3xl [&_h2]:text-[#0D0F0B] [&_h2]:font-['Big_Shoulders',system-ui,sans-serif] [&_h2]:font-extrabold [&_h2]:uppercase [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-1.5 [&_a]:underline [&_a]:underline-offset-2"
      >
        <slot />
      </div>
    </main>

    <footer class="w-full bg-[#0B0D09]">
      <div class="max-w-360 mx-auto px-6 md:px-16 pt-8 pb-8 flex flex-col gap-10">
        <nav
          aria-label="Enlaces del pie"
          class="border-t border-[#25291F] pt-8 flex flex-wrap items-center gap-x-2 text-[14px] text-[#A7AC9F] font-['Instrument_Sans',system-ui,sans-serif]"
        >
          <a href="/" class="underline underline-offset-4 hover:text-[#C7F14B]">Inicio</a>
          <span aria-hidden="true">·</span>
          <a
            href="/politicas-de-privacidad"
            class="underline underline-offset-4 hover:text-[#C7F14B]"
          >
            Política de Privacidad
          </a>
        </nav>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-[12px] tracking-[0.8px] text-[#8B9284] font-['Geist_Mono',system-ui,sans-serif]">
          <p>© 2026 juanra software. Todos los derechos reservados.</p>
          <ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold text-[#C7F14B]">
            <li>
              <a href="/politicas-de-privacidad" class="hover:underline">Política de Privacidad</a>
            </li>
            <li>
              <a href="/terminos-de-servicio" class="hover:underline">Términos de Servicio</a>
            </li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
