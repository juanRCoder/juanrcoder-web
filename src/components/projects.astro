---
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import MiCarrusel from "./MiCarrusel.astro";
---

<section
  id="proyectos"
  aria-labelledby="proyectos-title"
  data-pencil-name="Proyectos Realizados"
  class="bg-[#FFFFFF] w-full"
>
  <div class="max-w-360 mx-auto w-full flex flex-col gap-10 sm:gap-11 px-5 py-14 sm:px-8 sm:py-16 xl:px-16 xl:py-22">
    <header
      data-pencil-name="Head"
      class="w-full flex flex-col gap-6 sm:gap-7.5"
    >
      <div
        data-pencil-name="Eyebrow Row"
        class="w-full flex justify-between items-center"
      >
        <p
          data-pencil-name="Eyebrow"
          class="text-[9px]/[normal] sm:text-[11px]/[normal] text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.4px] sm:tracking-[2.4px] whitespace-nowrap"
        >
          02 — PROYECTOS REALIZADOS
        </p>
      </div>
      <div
        data-pencil-name="Head Main"
        class="w-full flex flex-col gap-5 sm:flex-row sm:gap-6 xl:gap-12 justify-between items-start sm:items-end"
      >
        <h3
          id="proyectos-title"
          data-pencil-name="Title"
          data-aos="fade-up"
          class="w-full sm:w-fit flex flex-col gap-2 sm:gap-4.5 text-[48px]/[44px] sm:text-[56px]/[50px] xl:text-[64px]/[55px] text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold"
        >
          <span class="block">TRABAJOS</span>
          <span class="block">REALIZADOS</span>
        </h3>
        <div
          role="group"
          aria-label="Controles del carrusel de proyectos"
          data-pencil-name="Slider Nav"
          class="flex gap-2 items-center self-end sm:self-auto"
        >
          <button
            type="button"
            data-projects-prev
            aria-label="Proyecto anterior"
            aria-controls="projects-track"
            data-pencil-name="Prev"
            class="w-11 h-11 flex items-center justify-center border border-[#D2D6C8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0D0F0B] cursor-pointer"
          >
            <ArrowLeft
              aria-hidden="true"
              class="w-4.25 h-4.25 text-[#0D0F0B]"
            />
          </button>
          <button
            type="button"
            data-projects-next
            aria-label="Siguiente proyecto"
            aria-controls="projects-track"
            data-pencil-name="Next"
            class="w-11 h-11 flex items-center justify-center bg-[#0D0F0B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0D0F0B] cursor-pointer"
          >
            <ArrowRight
              aria-hidden="true"
              class="w-4.25 h-4.25 text-[#f5f6ef]"
            />
          </button>
        </div>
      </div>
    </header>

    <MiCarrusel />
  </div>
</section>
