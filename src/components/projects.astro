---
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import MiCarrusel from "./MiCarrusel.astro";
---

<div data-pencil-name="Proyectos Realizados" class="bg-[#FFFFFF] w-full">
  <div class="max-w-360 mx-auto box-border w-full h-fit shrink-0 flex flex-col gap-10 sm:gap-11 px-5 py-14 sm:px-8 sm:py-16 xl:px-16 xl:py-22 justify-start items-start">
    <div
      data-pencil-name="Head"
      class="box-border w-full h-fit shrink-0 flex flex-col gap-6 sm:gap-7.5 justify-start items-start"
    >
      <div
        data-pencil-name="Eyebrow Row"
        class="box-border w-full h-fit shrink-0 flex flex-row gap-0 justify-between items-center"
      >
        <div
          data-pencil-name="Eyebrow"
          class="text-[9px]/[normal] sm:text-[11px]/[normal] box-border text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.4px] sm:tracking-[2.4px] text-left whitespace-nowrap"
        >
          02 — PROYECTOS REALIZADOS
        </div>
      </div>
      <div
        data-pencil-name="Head Main"
        class="box-border w-full h-fit shrink-0 flex flex-col gap-5 sm:flex-row sm:gap-6 xl:gap-12 justify-between items-start sm:items-end"
      >
        <div
          data-pencil-name="Title Wrap"
          class="box-border w-full sm:w-fit min-w-0 shrink-0 h-fit flex flex-col gap-2 sm:gap-4.5 justify-start items-start"
        >
          <div
            data-pencil-name="Title 1"
            class="text-[48px]/[44px] sm:text-[56px]/[50px] xl:text-[64px]/[55px] box-border text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left whitespace-normal"
          >
            TRABAJOS
          </div>
          <div
            data-pencil-name="Title 2"
            class="text-[48px]/[44px] sm:text-[56px]/[50px] xl:text-[64px]/[55px] box-border text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left whitespace-normal"
          >
            REALIZADOS
          </div>
        </div>
        <div
          data-pencil-name="Slider Nav"
          class="box-border w-fit shrink-0 h-fit flex flex-row gap-2 justify-start items-center self-end sm:self-auto"
        >
          <button
            type="button"
            data-projects-prev
            aria-label="Proyecto anterior"
            aria-controls="projects-track"
            data-pencil-name="Prev"
            class="box-border w-11 shrink-0 h-11 flex flex-col gap-0 justify-center items-center [border:1px_solid_#D2D6C8] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0D0F0B]"
          >
            <ArrowLeft class="box-border w-4.25 h-4.25 shrink-0 overflow-visible text-[#0D0F0B]" />
          </button>
          <button
            type="button"
            data-projects-next
            aria-label="Siguiente proyecto"
            aria-controls="projects-track"
            data-pencil-name="Next"
            class="box-border w-11 shrink-0 h-11 flex flex-col gap-0 justify-center items-center bg-[#0D0F0B] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0D0F0B]"
          >
            <ArrowRight class="box-border w-4.25 h-4.25 shrink-0 overflow-visible text-[#f5f6ef]" />
          </button>
        </div>
      </div>
    </div>

    <MiCarrusel />
  </div>
</div>
