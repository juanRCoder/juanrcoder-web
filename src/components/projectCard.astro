---
import { ArrowLeft, ArrowRight, ArrowUpRight } from "@lucide/astro";

// Tipo de cada proyecto (reutilizable)
export interface Project {
  name: string;
  accessibleName: string;
  category: string;
  year: string;
  lines: string[];
  url: string;
  meta: string;
  coverClass: string;
  coverBorderClass?: string;
  coverTextClass: string;
  detailTextClass: string;
  chipBorderClass: string;
  markClass: string;
}

interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
---

<div
  data-pencil-name={`Project ${project.name}`}
  data-project-slide
  role="group"
  aria-roledescription="slide"
  aria-label={`${index + 1} de ${total}: ${project.accessibleName}`}
  class="box-border w-105 shrink-0 h-fit flex flex-col gap-3.5 justify-start items-start"
>
  <div
    data-pencil-name="Cover"
    class={`box-border w-full h-[75 shrink-0 flex flex-col gap-0 p-5 justify-between items-start ${project.coverClass} ${project.coverBorderClass ?? ""} overflow-hidden`}
  >
    <div
      data-pencil-name="Cover Top"
      class="box-border w-full h-fit shrink-0 flex flex-row gap-0 justify-between items-center"
    >
      <div
        data-pencil-name="Category"
        class={`text-[9px]/[normal] box-border font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.4px] text-left whitespace-nowrap ${project.detailTextClass}`}
      >
        {project.category}
      </div>
      <div
        data-pencil-name="Year"
        class={`text-[9px]/[normal] box-border font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.4px] text-left whitespace-nowrap ${project.detailTextClass}`}
      >
        {project.year}
      </div>
    </div>
    <div
      data-pencil-name="Cover Name"
      class="box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start"
    >
      {project.lines.map((line) => (
        <div
          data-pencil-name="Name Line"
          class={`text-[58px]/[49px] box-border w-full font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left ${project.coverTextClass}`}
        >
          {line}
        </div>
      ))}
    </div>
    <div
      data-pencil-name="Cover Bottom"
      class="box-border w-full h-fit shrink-0 flex flex-row gap-0 justify-between items-center"
    >
      <div
        data-pencil-name="URL Chip"
        class={`box-border w-fit shrink-0 h-fit flex flex-row gap-0 p-[5px_8px] justify-start items-start ${project.chipBorderClass}`}
      >
        <div
          data-pencil-name="URL"
          class={`text-[9px]/[normal] box-border font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[0.6px] text-left whitespace-nowrap ${project.detailTextClass}`}
        >
          {project.url}
        </div>
      </div>
      <div
        data-pencil-name="Mark"
        class={`box-border w-6.5 shrink-0 h-0.75 ${project.markClass}`}
      ></div>
    </div>
  </div>
  <div
    data-pencil-name="Info"
    class="box-border w-full h-fit shrink-0 flex flex-row gap-4 justify-between items-start"
  >
    <div
      data-pencil-name="Info Left"
      class="box-border flex-[1_1_0] h-fit flex flex-col gap-1.25 justify-start items-start"
    >
      <div
        data-pencil-name="Project Name"
        class="text-[26px]/[26px] box-border w-full text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-bold text-left"
      >
        {project.name}
      </div>
      <div
        data-pencil-name="Project Meta"
        class="text-[10px]/[normal] box-border text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[0.6px] text-left whitespace-nowrap"
      >
        {project.meta}
      </div>
    </div>
    <ArrowUpRight class="box-border w-4.5 shrink-0 h-4.5 overflow-visible text-[#0d0f0b]" />
  </div>
</div>
