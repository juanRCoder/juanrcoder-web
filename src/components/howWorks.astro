---
interface Step {
  num: string;
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    num: "01",
    title: "Conversamos",
    description:
      "Nos cuentas sobre tu negocio, tus objetivos y lo que necesitas.",
  },
  {
    num: "02",
    title: "Diseño",
    description: "Creo la propuesta visual y la ajustamos contigo.",
  },
  {
    num: "03",
    title: "Desarrollo",
    description: "Construyo tu proyecto rápido, seguro y responsive.",
  },
  {
    num: "04",
    title: "Lanzamos",
    description: "Publicamos, probamos todo y te doy acompañamiento después.",
  },
];
---

<section aria-labelledby="como-funciona-title" class="bg-[#0B0D09] w-full">
  <div class="max-w-360 mx-auto w-full flex flex-col gap-10 sm:gap-15 px-5 py-14 sm:px-8 sm:py-16 xl:p-[104px_64px_110px_64px]">
    <header
      data-aos="fade-up"
      class="w-full flex flex-col gap-6 xl:flex-row xl:gap-12 justify-between xl:items-end"
    >
      <div class="w-full xl:w-196.75 flex flex-col gap-4 xl:gap-5">
        <p class="text-[11px]/[normal] text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[2.4px]">
          03 — CÓMO FUNCIONA
        </p>
        <h2
          id="como-funciona-title"
          class="text-[48px]/[44px] sm:text-[64px]/[60px] xl:text-[88px]/[87px] w-full xl:w-194 text-[#F5F6EF] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold"
        >
          PARA QUE EL SOFTWARE FUNCIONE.
        </h2>
      </div>
      <p class="text-[15px]/[24px] w-full max-w-75 xl:w-75 text-[#A7AC9F] font-['Instrument_Sans',system-ui,sans-serif]">
        Cuatro pasos, sin necesidad de un teatro de descubrimiento. Hablas
        directamente conmigo.
      </p>
    </header>

    <ol
      role="list"
      class="w-full grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-x-6 gap-y-8 xl:gap-10"
    >
      {steps.map((step, index) => (
        <li
          data-aos="fade-up"
          data-aos-delay={index * 100}
          class="group relative flex flex-col gap-4 pt-6"
        >
          <div class="absolute top-0 left-0 w-full h-px bg-[#25291F]" />
          <div class="absolute top-0 left-0 w-full h-px bg-[#C7F14B] scale-x-0 origin-left transition-transform duration-500 ease-out group-hover:scale-x-100" />

          <span class="text-[11px]/[normal] text-[#C7F14B] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px]">
            {step.num}
          </span>
          <h3 class="text-[36px]/[32px] text-[#F5F6EF] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold transition-colors duration-300 group-hover:text-[#C7F14B]">
            {step.title}
          </h3>
          <p class="text-[15px]/[26px] w-full text-[#A7AC9F] font-['Instrument_Sans',system-ui,sans-serif]">
            {step.description}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
