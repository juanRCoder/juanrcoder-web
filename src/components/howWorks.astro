---
interface Step {
  num: string;
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    num: "01",
    title: "Conversamos",
    description:
      "Nos cuentas sobre tu negocio, tus objetivos y lo que necesitas.",
  },
  {
    num: "02",
    title: "Diseño",
    description: "Creo la propuesta visual y la ajustamos contigo.",
  },
  {
    num: "03",
    title: "Desarrollo",
    description: "Construyo tu proyecto rápido, seguro y responsive.", // Typo corregido
  },
  {
    num: "04",
    title: "Lanzamos",
    description: "Publicamos, probamos todo y te doy acompañamiento después.",
  },
];
---

<div data-pencil-name="Cómo Funciona" class="bg-[#0B0D09] w-full">
  <div
    data-pencil-name="How It Works"
    class="max-w-360 mx-auto box-border w-full h-fit shrink-0 flex flex-col gap-10 sm:gap-15 px-5 py-14 sm:px-8 sm:py-16 xl:p-[104px_64px_110px_64px] justify-start items-start"
  >
    <!-- Sección de Encabezado (Se mantiene igual) -->
    <div
      data-pencil-name="Head"
      data-aos="fade-up"
      class="box-border w-full h-fit shrink-0 flex flex-col gap-6 xl:flex-row xl:gap-12 justify-between items-start xl:items-end"
    >
      <div
        data-pencil-name="Left"
        class="box-border w-full xl:w-196.75 shrink-0 h-fit flex flex-col gap-4 xl:gap-5 justify-start items-start"
      >
        <div
          data-pencil-name="Eyebrow"
          class="text-[11px]/[normal] box-border text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[2.4px] text-left whitespace-nowrap"
        >
          03 — CÓMO FUNCIONA
        </div>
        <div
          data-pencil-name="H2"
          class="text-12/[44px] sm:text-[64px]/[60px] xl:text-[88px]/[87px] box-border w-full xl:w-194 text-[#F5F6EF] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left whitespace-normal"
        >
          PARA QUE EL SOFTWARE FUNCIONE.
        </div>
      </div>
      <div
        data-pencil-name="Note"
        class="text-[15px]/[24px] box-border w-full max-w-75 xl:w-75 xl:shrink-0 text-[#A7AC9F] font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left"
      >
        Cuatro pasos, sin necesidad de un teatro de descubrimiento. Hablas
        directamente conmigo.
      </div>
    </div>

    <div
      data-pencil-name="Steps"
      class="box-border w-full h-fit shrink-0 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-x-6 gap-y-8 xl:gap-10"
    >
      {steps.map((step, index) => (
        <div
          data-pencil-name={`Step ${step.num}`}
          data-aos="fade-up"
          data-aos-delay={index * 100}
          // 1. Agregamos la clase 'group' y 'relative' al contenedor principal
          class="group relative box-border h-fit flex flex-col gap-4 pt-6 justify-start items-start"
        >
          <div class="absolute top-0 left-0 w-full h-px bg-[#25291F]" />
          <div class="absolute top-0 left-0 w-full h-px bg-[#C7F14B] scale-x-0 origin-left transition-transform duration-500 ease-out group-hover:scale-x-100" />

          <div
            data-pencil-name="Num"
            class="text-[11px]/[normal] box-border text-[#C7F14B] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.6px] text-left whitespace-nowrap"
          >
            {step.num}
          </div>
          <div
            data-pencil-name="Title"
            class="text-[36px]/[32px] box-border text-[#F5F6EF] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left transition-colors duration-300 group-hover:text-[#C7F14B]"
          >
            {step.title}
          </div>
          <div
            data-pencil-name="Body"
            class="text-[15px]/[26px] box-border w-full text-[#A7AC9F] font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left"
          >
            {step.description}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
