---
import { Mail } from "@lucide/astro";
import Button from "./ui/Button.astro";
---

<section
  id="contacto"
  aria-labelledby="contacto-title"
  data-pencil-name="Call to Action"
  class="bg-[#ddff75] w-full"
>
  <div
    data-pencil-name="CTA"
    class="max-w-360 mx-auto w-full flex flex-col gap-6 sm:gap-7 px-5 py-14 sm:px-8 sm:py-16 xl:p-[75px_64px]"
  >
    <p
      data-pencil-name="Eyebrow"
      class="text-[11px]/[normal] text-[#3A4712] font-['Geist_Mono',system-ui,sans-serif] tracking-[2.4px]"
    >
      04 — SIGUIENTE
    </p>
    <h2
      id="contacto-title"
      data-pencil-name="H2"
      data-aos="fade-up"
      class="text-[48px]/[46px] sm:text-[60px]/[58px] xl:text-[72px]/[68px] w-full max-w-167 text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold"
    >
      ¿Listo para hacer crecer tu negocio?
    </h2>
    <div
      data-pencil-name="CTA Bottom"
      class="w-full flex flex-col gap-6 pt-5 sm:flex-row sm:gap-8 xl:gap-12 justify-between items-start"
    >
      <p
        data-pencil-name="Sub"
        data-aos="fade-up"
        class="text-[17px]/[27px] w-full max-w-109 sm:flex-1 text-[#2A3410] font-['Instrument_Sans',system-ui,sans-serif]"
      >
        Dime cuál es la tarea que más te quita el día. Buscamos la forma de
        solucionarlo.
      </p>
      <div
        data-pencil-name="Buttons"
        class="w-full sm:w-fit flex flex-col gap-4.5 sm:items-end"
      >
        <Button
          label="Cotiza ahora"
          target="_blank"
          aria-label="Cotizar por WhatsApp"
          href="https://wa.me/956402456"
          class="bg-black text-white hover:-translate-y-px px-10 py-3"
        />
        <div data-pencil-name="Mail Row" class="flex gap-2 items-center">
          <Mail aria-hidden="true" class="w-3.5 h-3.5 text-[#0d0f0b]" />
          <a
            data-pencil-name="Mail"
            href="mailto:juanra@gmail.com"
            class="text-[11px]/[normal] sm:text-[13px]/[normal] text-[#0D0F0B] font-['Geist_Mono',system-ui,sans-serif] tracking-[0.4px] sm:tracking-[0.8px] whitespace-nowrap"
          >
            juanra@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
