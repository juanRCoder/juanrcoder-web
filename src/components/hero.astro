---
import Navbar from "./Navbar.astro";
import Button from "./ui/Button.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/hero_image_1.webp";
---

<section
  aria-labelledby="hero-title"
  class="w-full min-h-225 shrink-0 flex flex-col gap-12 md:gap-0 p-6 md:p-[44px_64px] justify-between items-start overflow-hidden relative bg-[#0B0D09]"
>
  <!-- Fondo con <Image /> de Astro: optimizado, responsive (srcset) y priorizado como LCP. Decorativo: alt vacío. -->
  <Image
    src={heroImage}
    alt=""
    aria-hidden="true"
    widths={[640, 1024]}
    sizes="100vw"
    format="webp"
    quality={80}
    priority
    class="absolute inset-0 w-full h-full object-cover object-center z-0 pointer-events-none select-none"
  />
  <div class="absolute inset-0 bg-[linear-gradient(180deg,#0B0D09F7_0%,#0B0D09CC_45%,#0B0D09D9_100%)] bg-no-repeat z-0" />
  <Navbar />
  <div aria-hidden="true" class="h-11 shrink-0" />
  <div class="w-full max-w-310 mx-auto h-fit shrink-0 flex flex-col gap-4 md:gap-6.5 items-start relative z-2">
    <p
      data-aos="fade-up"
      data-aos-delay={150}
      class="text-[10px] md:text-[12px] text-[#ddff75] font-['Geist_Mono',system-ui,sans-serif] tracking-[2px] md:tracking-[3px] text-left"
    >
      ESTUDIO WEB INDEPENDIENTE
    </p>

    <h1
      id="hero-title"
      data-aos="fade-up"
      data-aos-delay={300}
      class="text-[48px]/[1.1] sm:text-[64px]/[1.1] md:text-[92px]/[85px] text-[#F5F6EF] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left w-full"
    >
      SOLUCIONES DIGITALES PARA <br class="hidden lg:block" />
      <span data-aos="fade-up" data-aos-delay={400} class="text-[#ddff75]">
        POTENCIAR TU NEGOCIO
      </span>
    </h1>
    <p
      data-aos="fade-up"
      data-aos-delay={450}
      class="text-[16px]/[24px] md:text-[19px]/[29px] w-full md:w-171.25 max-w-full text-[#EDEFE6] font-['Instrument_Sans',system-ui,sans-serif] text-left mt-2 md:mt-0"
    >
      Creo desde páginas web profesionales hasta sistemas a medida, listos para
      operar y posicionar tu negocio en google.
    </p>
    <div
      data-aos="fade-up"
      data-aos-delay={450}
      class="w-full md:w-fit h-fit shrink-0 flex items-center mt-4 md:mt-0"
    >
      <Button
        target="_blank"
        aria-label="Cotizar por WhatsApp"
        href="https://wa.me/51956402456"
        class="bg-[#ddff75] hover:bg-[#b0d941] hover:shadow-[0_8px_25px_-8px_rgba(199,241,75,0.5)] text-[#121507] hover:-translate-y-px gap-2 px-7.5! py-4! font-['Instrument_Sans',system-ui,sans-serif]"
      >
        Cotizar mi proyecto ↗
      </Button>
    </div>
  </div>

  <div class="w-full h-fit shrink-0 flex flex-col md:flex-row gap-2 md:gap-0 pt-5 pb-4 md:pb-0 justify-between items-start md:items-center [border-width:1px_0px_0px_0px] border-solid border-[#F5F6EF33] relative z-3">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center w-full max-w-360 mx-auto gap-2 md:gap-0">
      <p class="text-[9px] md:text-[11px] text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px] text-left">
        01 - SITIOS WEB PROFESIONALES
      </p>
      <p class="text-[9px] md:text-[11px] text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px] text-left">
        02 — CATÁLOGOS DIGITALES PERSONALIZADOS
      </p>
      <p class="text-[9px] md:text-[11px] text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px] text-left">
        03 — SISTEMAS A MEDIDA
      </p>
    </div>
  </div>
</section>
