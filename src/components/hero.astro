---
import Navbar from "./Navbar.astro";
---

<div
  data-pencil-name="Hero"
  class="box-border w-full min-h-225 shrink-0 flex flex-col gap-12 md:gap-0 p-6 md:p-[44px_64px] justify-between items-start overflow-hidden relative"
  style="background-image: url('/hero_image.jpg'); background-position: center; background-repeat: no-repeat; background-size: cover"
>
  <div
    data-pencil-name="Scrim"
    class="absolute inset-0 bg-[linear-gradient(180deg,#0B0D09F7_0%,#0B0D09CC_45%,#0B0D09D9_100%)] bg-no-repeat z-0"
  />
  <Navbar />
  <div aria-hidden="true" class="h-11 shrink-0" />

  <!-- Contenido Principal (Hero Copy) -->
  <div
    data-pencil-name="Hero Copy"
    class="box-border w-full max-w-310 mx-auto h-fit shrink-0 flex flex-col gap-4 md:gap-6.5 justify-start items-start relative z-2"
  >
    <div class="text-[10px] md:text-[12px] box-border text-[#C7F14B] font-['Geist_Mono',system-ui,sans-serif] tracking-[2px] md:tracking-[3px] text-left">
      ESTUDIO WEB INDEPENDIENTE
    </div>

    <!-- Títulos: Letra más pequeña en móvil y permitimos saltos de línea -->
    <div class="text-[48px]/[1.1] sm:text-[64px]/[1.1] md:text-[92px]/[85px] box-border text-[#F5F6EF] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left w-full">
      SOLUCIONES DIGITALES PARA <br class="hidden lg:block" />
      <span class="text-[#C7F14B]">POTENCIA TU NEGOCIO</span>
    </div>
    <div class="text-[16px]/[24px] md:text-[19px]/[29px] box-border w-full md:w-171.25 max-w-full text-[#EDEFE6] font-['Instrument_Sans',system-ui,sans-serif] text-left mt-2 md:mt-0">
      Creo desde páginas web profesionales hasta sistemas a medida, listos para
      operar y posicionar tu negocio en google.
    </div>
    <div class="box-border w-full md:w-fit h-fit shrink-0 flex flex-row gap-6.5 justify-start items-center mt-4 md:mt-0">
      <a
        href="#contacto"
        class="w-full md:w-fit box-border flex justify-center md:justify-start p-[18px_30px] bg-[#C7F14B] hover:bg-[#b0d941] transition-colors"
      >
        <span class="text-[15px]/[normal] text-[#121507] font-['Instrument_Sans',system-ui,sans-serif] font-semibold text-center">
          Cotizar mi proyecto ↗
        </span>
      </a>
    </div>
  </div>

  <!-- Index Strip (Barra inferior) -->
  <div
    data-pencil-name="Index Strip"
    class="box-border w-full h-fit shrink-0 flex flex-col md:flex-row gap-2 md:gap-0 pt-5 pb-4 md:pb-0 justify-between items-start md:items-center [border-width:1px_0px_0px_0px] border-solid border-[#F5F6EF33] relative z-3"
  >
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center w-full max-w-360 mx-auto gap-2 md:gap-0">
      <div class="text-[9px] md:text-[11px] box-border text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px] text-left">
        01 - SITIOS WEB PROFESIONALES
      </div>
      <div class="text-[9px] md:text-[11px] box-border text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px] text-left">
        02 — CATÁLOGOS DIGITALES PERSONALIZADOS
      </div>
      <div class="text-[9px] md:text-[11px] box-border text-[#A7AC9F] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px] text-left">
        03 — SISTEMAS A MEDIDA
      </div>
    </div>
  </div>
</div>
