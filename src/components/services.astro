---
import Button from "./ui/Button.astro";

const solutions = [
  {
    number: "01",
    category: "SITIO WEB",
    title: ["PAGINAS", "WEB"],
    quoteMessage: "Hola, quiero cotizar una página web para mi negocio.",
    description: "Lista para campañas de publicidad y para aparecer en Google.",
    features: [
      "Diseño a medida, sin plantillas",
      "Redacción persuasiva (copy)",
      "SEO básico + Google Maps",
      "Botón y link a WhatsApp",
      "Formulario de contacto",
      "Publicación y dominio incluidos",
    ],
    timelineValue: "1 - 7 DÍAS aprox",
    progressWidth: "28%",
    theme: {
      bg: "bg-[#0B0D09]",
      border: "border-[#0D0F0B]",
      textMain: "text-[#F5F6EF]",
      textMuted: "text-[#A7AC9F]",
      featureBorder: "border-[#25291F]",
      bullet: "bg-[#ddff75]",
      progressTrack: "bg-[#25291F]",
      progressBar: "bg-[#ddff75]",
      quoteButton:
        "bg-[#ddff75] text-[#0D0F0B] hover:bg-[#b0d941]",
    },
  },
  {
    number: "02",
    category: "COMERCIO",
    title: ["MENÚS", "DIGITALES"],
    quoteMessage: "Hola, quiero cotizar un catálogo digital para mi negocio.",
    description:
      "Tu menú real, con fotos y precios. Para negocios que actualizan productos y precios seguido.",
    features: [
      "35 productos cargados(negociable)",
      "Categorías y buscador",
      "Panel para que actualices solo",
      "SEO de productos + Google Maps",
      "Carrito con pedido a WhatsApp",
    ],
    timelineValue: "1 - 14 DÍAS aprox",
    progressWidth: "55%",
    theme: {
      bg: "bg-[#ddff75]",
      border: "border-[#ddff75]",
      textMain: "text-[#0D0F0B]",
      textMuted: "text-[#3A4712]",
      featureBorder: "border-[#AFD93F]",
      bullet: "bg-[#0D0F0B]",
      progressTrack: "bg-[#AFD93F]",
      progressBar: "bg-[#0D0F0B]",
      quoteButton:
        "bg-[#0D0F0B] text-[#F5F6EF] hover:bg-[#25291F]",
    },
  },
  {
    number: "03",
    category: "SOFTWARE",
    title: ["SISTEMA", "A MEDIDA"],
    quoteMessage: "Hola, quiero cotizar un sistema a medida para mi negocio.",
    description:
      "Automatiza procesos, gestiona tu negocio, inventario y clientes desde un solo lugar.",
    features: [
      "Paneles administrativos",
      "Reservas y pedidos",
      "Control de stock, ventas y reportes exportables",
      "Capacitación y soporte",
    ],
    timelineValue: "MÁX. 1 MES aprox",
    progressWidth: "100%",
    theme: {
      bg: "bg-[#FFFFFF]",
      border: "border-[#0D0F0B]",
      textMain: "text-[#0D0F0B]",
      textMuted: "text-[#5C6158]",
      featureBorder: "border-[#D2D6C8]",
      bullet: "bg-[#0D0F0B]",
      progressTrack: "bg-[#D2D6C8]",
      progressBar: "bg-[#0D0F0B]",
      quoteButton:
        "bg-[#0D0F0B] text-[#F5F6EF] hover:bg-[#25291F]",
    },
  },
];
---

<div
  id="servicios"
  class="w-full max-w-360 mx-auto flex flex-col gap-10 sm:gap-12 xl:gap-14 px-5 py-14 sm:px-8 xl:p-[66px_64px_126px_64px] bg-[#EFF1EA]"
>
  <div class="w-full flex flex-col gap-6 xl:flex-row xl:gap-12 justify-between items-start xl:items-end">
    <div class="w-full xl:w-fit flex flex-col gap-4 xl:gap-5">
      <p class="text-[11px]/[normal] text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] tracking-[2.4px]">
        01 — LO QUE CONSTRUYO
      </p>
      <h2
        data-aos="fade-up"
        data-aos-delay={150}
        class="text-[48px]/[44px] sm:text-[64px]/[56px] xl:text-[88px]/[76px] text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold"
      >
        TRES SOLUCIONES
      </h2>
      <p
        data-aos="fade-up"
        data-aos-delay={300}
        class="text-[48px]/[44px] sm:text-[64px]/[56px] xl:text-[88px]/[76px] text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold"
      >
        ELIGE LA TUYA
      </p>
    </div>
    <div
      data-aos="fade-up"
      data-aos-delay={300}
      class="text-[15px]/[24px] w-full max-w-86.75 xl:w-85.75 text-[#5C6158] font-['Instrument_Sans',system-ui,sans-serif]"
    >
      Plazos cortos y reales: una landing en una semana, un menú en dos, un
      sistema en un mes. Sin sorpresas ni fechas que se estiran.
    </div>
  </div>

  <div class="w-full xl:h-133.5 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    {solutions.map((solution, index) => (
      <div
        data-aos="fade-up"
        data-aos-delay={index * 100}
        class="w-full h-full"
      >
        <div
          class={`group w-full min-h-133.5 xl:h-full flex flex-col gap-6 p-5 sm:p-6 xl:p-6.5 justify-between border ${solution.theme.bg} ${solution.theme.border} cursor-pointer transition-transform duration-300 ease-out hover:-translate-y-2`}
        >
          <div class="w-full flex flex-col gap-4.5">
            <div class="w-full flex justify-between items-center">
              <div
                class={`text-[11px]/[normal] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.6px] ${solution.theme.textMuted}`}
              >
                {solution.number}
              </div>
              <p
                class={`text-[9px]/[normal] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.4px] ${solution.theme.textMuted}`}
              >
                {solution.category}
              </p>
            </div>

            <div class="w-full flex flex-col">
              {solution.title.map((line) => (
                <div
                  class={`text-[42px]/[38px] sm:text-[48px]/[42px] xl:text-[52px]/[44px] w-full font-['Big_Shoulders',system-ui,sans-serif] font-extrabold ${solution.theme.textMain}`}
                >
                  {line}
                </div>
              ))}
            </div>

            <div
              class={`text-[14px]/[22px] w-full font-['Instrument_Sans',system-ui,sans-serif] ${solution.theme.textMuted}`}
            >
              {solution.description}
            </div>
          </div>

          <div class="w-full flex flex-col">
            {solution.features.map((feature) => (
              <div
                class={`w-full flex gap-2.5 py-2.75 items-center border-t ${solution.theme.featureBorder}`}
              >
                <div class={`w-1.5 h-1.5 ${solution.theme.bullet}`} />
                <div
                  class={`text-[13.5px]/[18px] flex-1 font-['Instrument_Sans',system-ui,sans-serif] ${solution.theme.textMain}`}
                >
                  {feature}
                </div>
              </div>
            ))}
          </div>

          <div class="w-full flex flex-col gap-2.25">
            <div class="w-full flex flex-wrap gap-x-2 gap-y-1 justify-between">
              <div
                class={`text-[9.5px]/[normal] font-['Geist_Mono',system-ui,sans-serif] tracking-[1.4px] ${solution.theme.textMuted}`}
              >
                PLAZO DE ENTREGA
              </div>
              <div
                class={`text-[13px]/[normal] font-['Geist_Mono',system-ui,sans-serif] font-medium tracking-[0.8px] ${solution.theme.textMain}`}
              >
                {solution.timelineValue}
              </div>
            </div>
            <div
              class={`w-full h-0.75 overflow-hidden ${solution.theme.progressTrack}`}
            >
              <div
                class={`h-full ${solution.theme.progressBar}`}
                style={`width: ${solution.progressWidth}`}
              />
            </div>
            <Button
              label="Cotizar ↗"
              href={`https://wa.me/51956402456?text=${encodeURIComponent(solution.quoteMessage)}`}
              target="_blank"
              aria-label={`Cotizar ${solution.category.toLowerCase()} por WhatsApp`}
              class={`w-full mt-2 font-['Instrument_Sans',system-ui,sans-serif] ${solution.theme.quoteButton}`}
            />
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
