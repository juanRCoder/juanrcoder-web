---
// 1. Definimos la estructura de los datos y los temas
const solutions = [
  {
    number: "01",
    category: "SITIO WEB",
    title: ["PAGINAS", "WEB"],
    description:
      "Una sola página pensada para que quien entre entienda qué hacés y te escriba. Rápida, clara, sin ruido.",
    features: [
      "Diseño a medida, sin plantillas",
      "Textos y estructura incluidos",
      "Optimizada para Google",
      "Publicación y dominio",
    ],
    timelineValue: "1 – 7 DÍAS aprox",
    progressWidth: "28%",
    theme: {
      bg: "bg-[#0B0D09]",
      border: "border-[#0D0F0B]",
      textMain: "text-[#F5F6EF]",
      textMuted: "text-[#A7AC9F]",
      featureBorder: "border-[#25291F]",
      bullet: "bg-[#C7F14B]",
      progressTrack: "bg-[#25291F]",
      progressBar: "bg-[#C7F14B]",
    },
  },
  {
    number: "02",
    category: "COMERCIO",
    title: ["CATÁLOGO", "DIGITALES"],
    description:
      "Tu catálogo real, con fotos, precios y stock. Eligen, piden por WhatsApp y el pedido te llega detallado.",
    features: [
      "Carga de productos y fotos",
      "Pedido armado automático",
      "Sin comisiones por venta",
      "Actualizable sin depender de mí",
    ],
    timelineValue: "1 – 14 DÍAS aprox",
    progressWidth: "55%",
    theme: {
      bg: "bg-[#C7F14B]",
      border: "border-[#C7F14B]",
      textMain: "text-[#0D0F0B]",
      textMuted: "text-[#3A4712]",
      featureBorder: "border-[#AFD93F]",
      bullet: "bg-[#0D0F0B]",
      progressTrack: "bg-[#AFD93F]",
      progressBar: "bg-[#0D0F0B]",
    },
  },
  {
    number: "03",
    category: "SOFTWARE",
    title: ["SISTEMA", "A MEDIDA"],
    description:
      "Automatiza procesos, gestiona tu negocio, inventario y clientes desde un solo lugar.",
    features: [
      "Relevamiento y alcance de productos limitado",
      "Usuarios, roles y permisos",
      "Reportes, gestion y cierres",
      "Capacitación y soporte",
    ],
    timelineValue: "MÁX. 1 MES aprox",
    progressWidth: "100%",
    theme: {
      bg: "bg-[#FFFFFF]",
      border: "border-[#0D0F0B]",
      textMain: "text-[#0D0F0B]",
      textMuted: "text-[#5C6158]",
      featureBorder: "border-[#D2D6C8]",
      bullet: "bg-[#0D0F0B]",
      progressTrack: "bg-[#D2D6C8]",
      progressBar: "bg-[#0D0F0B]",
    },
  },
];
---

<div
  id="servicios"
  data-pencil-name="What I Build"
  class="box-border w-full max-w-360 mx-auto h-fit shrink-0 flex flex-col gap-10 sm:gap-12 xl:gap-14 px-5 py-14 sm:px-8 xl:p-[66px_64px_96px_64px] justify-start items-start bg-[#EFF1EA]"
>
  <!-- Section Head -->
  <div
    data-pencil-name="Section Head"
    data-aos="fade-up"
    class="box-border w-full h-fit shrink-0 flex flex-col gap-6 xl:flex-row xl:gap-12 justify-between items-start xl:items-end"
  >
    <div class="box-border w-full xl:w-fit shrink-0 h-fit flex flex-col gap-4 xl:gap-5 justify-start items-start">
      <div class="text-[11px]/[normal] box-border text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[2.4px] text-left">
        01 — LO QUE CONSTRUYO
      </div>
      <div class="text-[48px]/[44px] sm:text-[64px]/[56px] xl:text-[88px]/[76px] box-border text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left whitespace-normal">
        TRES SOLUCIONES
      </div>
      <div class="text-[48px]/[44px] sm:text-[64px]/[56px] xl:text-[88px]/[76px] box-border text-[#0D0F0B] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left whitespace-normal">
        ELIGE LA TUYA
      </div>
    </div>
    <div class="text-[15px]/[24px] box-border w-full max-w-86.75 xl:w-85.75 xl:shrink-0 text-[#5C6158] font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left">
      Plazos cortos y reales: una landing en una semana, un catálogo en dos, un
      sistema en un mes. Sin sorpresas ni fechas que se estiran.
    </div>
  </div>

  <!-- Contenedor de Tarjetas -->
  <div
    data-pencil-name="Cards"
    class="box-border w-full h-fit xl:h-133.5 shrink-0 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 items-stretch"
  >
    {solutions.map((solution) => (
      <div
        data-pencil-name={`Card ${solution.title.join(" ")}`}
        class={`group box-border w-full min-h-133.5 xl:h-full flex flex-col gap-6 p-5 sm:p-6 xl:p-6.5 justify-between items-start overflow-hidden border ${solution.theme.bg} ${solution.theme.border} 
        transition-all duration-300 ease-out cursor-default 
        hover:-translate-y-2 hover:shadow-2xl hover:scale-[1.02]`}
      >
        <!-- Top (Número, Categoría, Título, Descripción) -->
        <div
          data-aos="fade-up"
          class="box-border w-full h-fit shrink-0 flex flex-col gap-4.5 justify-start items-start"
        >
          <div class="box-border w-full h-fit shrink-0 flex flex-row gap-0 justify-between items-center">
            <div
              class={`text-[11px]/[normal] box-border font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.6px] text-left ${solution.theme.textMuted}`}
            >
              {solution.number}
            </div>
            <div
              class={`text-[9px]/[normal] box-border font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.4px] text-left ${solution.theme.textMuted}`}
            >
              {solution.category}
            </div>
          </div>

          <div class="box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start">
            {solution.title.map((line) => (
              <div
                class={`text-[42px]/[38px] sm:text-[48px]/[42px] xl:text-[52px]/[44px] box-border w-full font-['Big_Shoulders',system-ui,sans-serif] font-extrabold text-left ${solution.theme.textMain}`}
              >
                {line}
              </div>
            ))}
          </div>

          <div
            class={`text-[14px]/[22px] box-border w-full font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left ${solution.theme.textMuted}`}
          >
            {solution.description}
          </div>
        </div>

        <!-- Features (Lista de características) -->
        <div class="box-border w-full h-fit shrink-0 flex flex-col gap-0 justify-start items-start">
          {solution.features.map((feature) => (
            <div
              class={`box-border w-full h-fit shrink-0 flex flex-row gap-2.5 p-[11px_0px] justify-start items-center border-t ${solution.theme.featureBorder}`}
            >
              <div
                class={`box-border w-1.5 shrink-0 h-1.5 ${solution.theme.bullet}`}
              ></div>
              <div
                class={`text-[13.5px]/[18px] box-border flex-[1_1_0] font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left ${solution.theme.textMain}`}
              >
                {feature}
              </div>
            </div>
          ))}
        </div>

        <!-- Timeline (Plazo y Barra de progreso) -->
        <div class="box-border w-full h-fit shrink-0 flex flex-col gap-2.25 justify-start items-start">
          <div class="box-border w-full h-fit shrink-0 flex flex-row flex-wrap gap-x-2 gap-y-1 justify-between items-start">
            <div
              class={`text-[9.5px]/[normal] box-border font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.4px] text-left  ${solution.theme.textMuted}`}
            >
              PLAZO DE ENTREGA
            </div>
            <div
              class={`text-[13px]/[normal] box-border font-['Geist_Mono',system-ui,sans-serif] font-medium tracking-[0.8px] text-left ${solution.theme.textMain}`}
            >
              {solution.timelineValue}
            </div>
          </div>
          <div
            class={`box-border w-full h-0.75 shrink-0 flex flex-row gap-0 justify-start items-start overflow-hidden ${solution.theme.progressTrack}`}
          >
            <div
              class={`box-border shrink-0 h-full ${solution.theme.progressBar}`}
              style={`width: ${solution.progressWidth}`}
            ></div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
