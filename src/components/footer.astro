---
// 1. Definimos los datos del Footer en un objeto
const footerData = {
  tagline:
    "Desarrollador de Software especializado en aplicaciones web, dashboards, sistemas logísticos personalizados. Experiencia con NestJS, React, SQL y arquitecturas escalables",
  columns: [
    {
      title: "Construyo",
      links: [
        "Paginas Web",
        "Catalogos Digitales Personalizados",
        "Sistemas de Gestion y Logistica",
      ],
    },
    {
      title: "Redes",
      links: ["Facebook", "Instagram", "Tiktok"],
    },
  ],
  legalLinks: [
    "Cookies",
    "Politicas de privacidad",
    "Terminos de servicio",
    "Libro de reclamaciones",
  ],
  copyright: "© 2026 Todos los derechos reservados.",
};
---

<div data-pencil-name="Footera" class="bg-[#0B0D09] w-full">
  <div
    data-pencil-name="Footer"
    class="max-w-360 mx-auto box-border w-full h-fit shrink-0 flex flex-col gap-10 sm:gap-[56px] px-5 pt-14 pb-8 sm:px-8 sm:py-16 xl:p-[72px_64px_40px_64px] justify-start items-start"
  >
    <div
      data-pencil-name="Footer Top"
      class="box-border w-full h-fit shrink-0 flex flex-col gap-10 xl:flex-row xl:gap-[64px] justify-between items-start"
    >
      <!-- Columna de la Marca -->
      <div
        data-pencil-name="Brand"
        class="box-border w-full xl:flex-1 shrink-0 h-fit flex flex-col gap-[14px] justify-start items-start"
      >
        <div
          data-pencil-name="Mark"
          class="box-border w-fit h-fit shrink-0 flex flex-row gap-[10px] justify-start items-center"
        >
          <div
            data-pencil-name="Wordmark"
            class="box-border w-fit shrink-0 h-fit flex flex-row gap-[10px] justify-start items-center"
          >
            <div
              data-pencil-name="calogo1 1"
              class="box-border w-[39px] shrink-0 h-[44px]"
              style="background-image: url('/logo1.png'); background-position: center; background-repeat: no-repeat; background-size: cover"
              /* Corrección: quitamos /public/ de la URL */
            ></div>
            <div
              data-pencil-name="Logo Type"
              class="text-[18px]/[normal] box-border text-[#A7AC9F] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold tracking-[1px] text-left [white-space:nowrap]"
            >
              juanra
              <br />
              software
            </div>
          </div>
        </div>
        <div
          data-pencil-name="Tagline"
          class="text-[15px]/[25px] box-border w-full max-w-[401px] text-[#A7AC9F] font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left"
        >
          {footerData.tagline}
        </div>
      </div>

      <!-- Columnas de Enlaces -->
      <div
        data-pencil-name="Footer Columns"
        class="box-border w-full xl:w-fit shrink-0 h-fit grid grid-cols-2 gap-x-6 gap-y-8 sm:gap-x-12 xl:flex xl:gap-[72px] justify-start items-start"
      >
        {footerData.columns.map((column) => (
          <div
            data-pencil-name={`Col ${column.title.toUpperCase()}`}
            class="box-border w-full min-w-0 shrink-0 h-fit flex flex-col gap-[12px] justify-start items-start"
          >
            <div
              data-pencil-name="Title"
              class="text-[10px]/[normal] box-border text-[#F5F6EF] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[1.8px] text-left [white-space:nowrap]"
            >
              {column.title}
            </div>
            {column.links.map((link) => (
              <div
                data-pencil-name={`Link ${link}`}
                class="text-[14px]/[normal] box-border text-[#5C6158] font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left whitespace-normal break-words"
              >
                {link}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Footer Bottom (Enlaces Legales y Copyright) -->
    <div
      data-pencil-name="Footer Bottom"
      class="box-border w-full h-fit shrink-0 flex flex-col gap-5 pt-5 sm:flex-row sm:gap-0 sm:justify-between sm:items-start [border-width:1px_0px_0px_0px] [border-style:solid] [border-color:#25291F]"
    >
      <div
        data-pencil-name="Copy"
        class="text-[9px]/[normal] sm:text-[10px]/[normal] box-border text-[#8B9284] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[0.8px] sm:tracking-[1.2px] text-left whitespace-nowrap"
      >
        {footerData.copyright}
      </div>

      <div
        data-pencil-name="Note"
        class="text-[9px]/[normal] sm:text-[10px]/[normal] box-border w-full sm:w-fit text-[#8B9284] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[0.8px] sm:tracking-[1.2px] text-left whitespace-nowrap flex gap-x-2 gap-y-1 flex-wrap"
      >
        {footerData.legalLinks.map((legal) => (
          <p>{legal}</p>
        ))}
      </div>
    </div>
  </div>
</div>
