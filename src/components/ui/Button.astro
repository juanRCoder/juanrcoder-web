---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type"> & {
  label?: string;
  href?: string;
  type?: "button" | "submit" | "reset";
};

const {
  label,
  href,
  type = "button",
  target,
  rel,
  class: className = "",
  ...attrs
} = Astro.props;

const isLink = Boolean(href);
const Tag = isLink ? "a" : "button";
const linkRel =
  rel ?? (target === "_blank" ? "noopener noreferrer" : undefined);

const baseClass =
  "relative cursor-pointer py-2 px-8 text-center inline-flex justify-center text-base transition-[transform,translate,background-color,border-color,color,box-shadow] duration-300 ease-in-out group outline-offset-4 focus:outline-2 focus:outline-offset-4 overflow-hidden rounded-sm";
---

<Tag
  {...attrs}
  class={`${baseClass} ${className}`.trim()}
  href={href}
  type={isLink ? undefined : type}
  target={target}
  rel={isLink ? linkRel : undefined}
>
  <span class="relative z-20">{label ?? <slot />}</span>
  <!-- Brillo -->
  <span
    aria-hidden="true"
    class="absolute -left-full top-[-50%] h-[200%] w-[45%] rotate-30 bg-linear-to-r from-transparent via-white/40 to-transparent z-10 blur-md group-hover:left-[150%] transition-all duration-500 ease-out"
  ></span>
</Tag>
