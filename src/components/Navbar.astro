---
import { Menu, X } from "@lucide/astro";
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
import logoImage from "../assets/logo1.webp";

const navLinks = [
  { href: "#servicios", label: "Servicios" },
  // { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
] as const;
---

<header
  data-navbar
  class="fixed inset-x-0 top-0 z-50 bg-[#0B0D09]/75 backdrop-blur-md"
>
  <div class="max-w-360 mx-auto px-6 md:px-16 py-3 md:py-5.5 flex justify-between items-center">
    <div class="flex gap-2.5 items-center">
      <Image
        src={logoImage}
        alt=""
        class="w-9.75 h-11 object-cover"
        decoding="async"
      />
      <div class="text-[18px]/[normal] text-[#A7AC9F] font-['Big_Shoulders',system-ui,sans-serif] font-extrabold tracking-[1px] whitespace-nowrap">
        juanra
        <br />
        software
      </div>
    </div>

    <nav
      aria-label="Navegación principal"
      class="hidden md:flex gap-8.5 items-center"
    >
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="text-xs/[normal] text-[#A7AC9F] hover:text-[#F5F6EF] transition-colors font-['Geist_Mono',system-ui,sans-serif] tracking-[1.2px]"
        >
          {label}
        </a>
      ))}
    </nav>

    <Button
      label="Hablemos ↗"
      target="_blank"
      href="https://wa.me/51956402456"
      aria-label="Cotizar por WhatsApp"
      class="hidden! md:flex! bg-transparent hover:bg-white/10 hover:shadow-[0_0_15px_rgba(245,246,239,0.2)] text-white hover:-translate-y-px gap-2 font-['Instrument_Sans',system-ui,sans-serif] border border-[#F5F6EF]/50 px-3.5 py-2.5"
    />

    <button
      type="button"
      data-menu-toggle
      class="md:hidden flex justify-center items-center text-[#F5F6EF] p-2 cursor-pointer"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <Menu class="w-7 h-7" data-icon-open />
      <X class="w-7 h-7" data-icon-close aria-hidden="true" />
    </button>
  </div>

  <nav
    id="mobile-navigation"
    data-mobile-menu
    data-open="false"
    aria-hidden="true"
    aria-label="Navegación móvil"
    class="absolute inset-x-0 top-full bg-[#0B0D09]/75 backdrop-blur-md border-y border-[#F5F6EF]/15 shadow-[0_12px_32px_rgba(0,0,0,0.3)] md:hidden"
  >
    <div class="mx-auto flex w-full max-w-360 flex-col px-6 md:px-16">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="px-4 py-4 text-xs text-center text-[#A7AC9F] hover:text-[#C7F14B] transition-colors font-['Geist_Mono',system-ui,sans-serif] tracking-[1.2px]"
        >
          {label}
        </a>
      ))}
      <a
        href="https://wa.me/51956402456"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-4 text-xs text-center text-[#A7AC9F] hover:text-[#C7F14B] transition-colors font-['Geist_Mono',system-ui,sans-serif] tracking-[1.2px]"
      >
        Hablemos
      </a>
    </div>
  </nav>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  if (menuButton && mobileMenu) {
    const setMenuOpen = (isOpen: boolean) => {
      mobileMenu.dataset.open = String(isOpen);
      mobileMenu.setAttribute("aria-hidden", String(!isOpen));
      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.setAttribute(
        "aria-label",
        isOpen ? "Cerrar menú" : "Abrir menú",
      );
    };

    const closeMenu = () => setMenuOpen(false);

    menuButton.addEventListener("click", () => {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isExpanded);
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Click fuera → cerrar
    document.addEventListener("click", (event) => {
      if (mobileMenu.dataset.open !== "true") return;
      const target = event.target as Node;
      if (mobileMenu.contains(target)) return;
      if (menuButton.contains(target)) return;
      closeMenu();
    });

    // Esc → cerrar y devolver foco
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || mobileMenu.dataset.open !== "true") return;
      closeMenu();
      menuButton.focus();
    });
  }
</script>

<style>
  [data-mobile-menu] {
    opacity: 0;
    transform: translateY(-0.75rem);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 180ms ease-out,
      transform 180ms ease-out,
      visibility 180ms;
  }

  [data-mobile-menu][data-open="true"] {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }

  [data-menu-toggle] [data-icon-close] {
    display: none;
  }
  [data-menu-toggle][aria-expanded="true"] [data-icon-open] {
    display: none;
  }
  [data-menu-toggle][aria-expanded="true"] [data-icon-close] {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mobile-menu] {
      transition: none;
    }
  }
</style>
