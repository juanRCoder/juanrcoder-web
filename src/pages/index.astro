---
import SEO from "../components/SEO.astro";
import Hero from "../components/hero.astro";
import Services from "../components/services.astro";
// import Projects from "../components/projects.astro";
import HowWorks from "../components/howWorks.astro";
import Cta from "../components/cta.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import logoImage from "../assets/logo1.webp";
import heroImage from "../assets/hero_image_1.webp";

const title = "juanra software | Páginas web y sistemas a medida en Lima";
const description =
  "Desarrollador web en Lima, Perú: páginas web profesionales, menús digitales y sistemas de gestión a medida para negocios. Hablas directo conmigo, sin intermediarios.";
const siteUrl = Astro.site!.href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}#business`,
      name: "juanra software",
      alternateName: ["Juanra Software", "juanrasoftware"],
      description:
        "Desarrollo de páginas web, menús digitales y sistemas de gestión a medida en Lima, Perú",
      url: siteUrl,
      logo: new URL(logoImage.src, siteUrl).href,
      image: new URL(heroImage.src, siteUrl).href,
      areaServed: [
        { "@type": "City", name: "Lima" },
        { "@type": "Country", name: "Perú" },
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Lima",
        addressRegion: "Lima",
        addressCountry: "PE",
      },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios",
        itemListElement: [
          "Páginas web profesionales",
          "Menús digitales personalizados",
          "Sistemas de gestión y logística a medida",
        ].map((name) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name },
        })),
      },
      knowsLanguage: "es",
      telephone: "+51956402456",
      email: "juanra@gmail.com",
      sameAs: ["https://www.tiktok.com/@juanrasoftware"],
      founder: { "@id": `${siteUrl}#person` },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: "Juanra",
      alternateName: ["juanra", "Juanra Software"],
      jobTitle: "Desarrollador web",
      url: siteUrl,
      worksFor: { "@id": `${siteUrl}#business` },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Lima",
        addressCountry: "PE",
      },
      sameAs: ["https://www.tiktok.com/@juanrasoftware"],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "juanra software",
      inLanguage: "es-PE",
      publisher: { "@id": `${siteUrl}#business` },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0D09" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <script
    async
    src="https://www.googletagmanager.com/gtm.js?id=GTM-WP9XJ9DM"
  ></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    gtag("js", new Date());
  </script>
  <body class="box-border h-fit flex flex-col gap-0 justify-start items-start bg-[#EFF1EA] mx-auto overflow-x-hidden">
    <Hero />
    <div
      data-pencil-name="Interlude"
      class="w-full max-w-360 mx-auto flex flex-col gap-6 p-[80px_12px] md:p-[80px_64px] bg-[#EFF1EA] border-t border-[#D2D6C8]"
    >
      <div
        data-aos="fade-up"
        data-aos-delay={150}
        data-pencil-name="Eyebrow"
        class="text-[11px]/[normal] text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] tracking-[2.4px] whitespace-nowrap"
      >
        LA VERSIÓN CORTA
      </div>
      <h2
        data-pencil-name="Quote"
        data-aos="fade-up"
        data-aos-delay={300}
        class="text-4xl md:text-[58px] text-[#0D0F0B] tracking-tighter font-['Big_Shoulders',system-ui,sans-serif] font-bold"
      >
        LA MAYORÍA DE LO QUE NECESITAS YA EXISTE. <br class="hidden lg:block" />{" "}
        SIMPLEMENTE NO FUE DISEÑADO PARA TU NEGOCIO.
      </h2>
      <div
        data-pencil-nameF="Quote Foot"
        class="w-fit flex gap-3 pt-2 items-center"
      >
        <div data-pencil-name="Rule" class="w-14 h-0.5 bg-[#0D0F0B]" />
        <p
          data-pencil-name="Note"
          data-aos="fade-up"
          data-aos-delay={450}
          class="aos-item text-[15px]/[normal] text-[#5C6158] font-['Instrument_Sans',system-ui,sans-serif]"
        >
          Sin intermediarios: hablás conmigo.
        </p>
      </div>
    </div>
    <Services />
    <!-- <Projects /> -->
    <HowWorks />
    <Cta />
    <Footer />
  </body>
</html>

<script>
  import { initAOS } from "../js/aos.js";

  initAOS();
</script>
