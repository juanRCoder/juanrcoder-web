---
import Hero from "../components/hero.astro";
import Services from "../components/services.astro";
import Projects from "../components/projects.astro";
import HowWorks from "../components/howWorks.astro";
import Cta from "../components/cta.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";

const title = "juanrcoder-web";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sitio personal de juanrcoder." />
    <title>{title}</title>
  </head>
  <body class="box-border h-fit flex flex-col gap-0 justify-start items-start bg-[#EFF1EA] mx-auto overflow-x-hidden">
    <Hero />
    <div
      data-pencil-name="Interlude"
      class="box-border w-full max-w-360 mx-auto h-fit shrink-0 flex flex-col gap-6 p-[80px_12px] md:p-[80px_64px] justify-start items-start bg-[#EFF1EA] [border-width:1px_0px_0px_0px] border-solid border-[#D2D6C8]"
    >
      <div
        data-pencil-name="Eyebrow"
        class="text-[11px]/[normal] box-border text-[#5C6158] font-['Geist_Mono',system-ui,sans-serif] font-normal tracking-[2.4px] text-left whitespace-nowrap"
      >
        LA VERSIÓN CORTA
      </div>
      <div
        data-pencil-name="Quote"
        class="text-4xl md:text-[58px] box-border text-[#0D0F0B] tracking-tighter font-['Big_Shoulders',system-ui,sans-serif] font-bold text-left"
      >
        LA MAYORÍA DE LO QUE NECESITAS YA EXISTE. <br class="hidden lg:block" />{" "}SIMPLEMENTE NO FUE DISEÑADO
        PARA TU NEGOCIO.
      </div>
      <div
        data-pencil-nameF="Quote Foot"
        class="box-border w-fit h-fit shrink-0 flex flex-row gap-3 p-[8px_0px_0px_0px] justify-start items-center"
      >
        <div
          data-pencil-name="Rule"
          class="box-border w-14 shrink-0 h-0.5 bg-[#0D0F0B]"
        ></div>
        <div
          data-pencil-name="Note"
          class="text-[15px]/[normal] box-border text-[#5C6158] font-['Instrument_Sans',system-ui,sans-serif] font-normal text-left"
        >
          Sin intermediarios: hablás conmigo.
        </div>
      </div>
    </div>
    <Services />
    <Projects />
    <HowWorks />
    <Cta />
    <Footer />
  </body>
</html>
