---
import '../styles/global.css';

const title = 'juanrcoder-web';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Sitio personal de juanrcoder." />
    <title>{title}</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-slate-50 font-sans text-slate-900">
    <main class="p-8 text-center">
      <h1 class="mb-2 text-4xl font-bold">Hola, mundo</h1>
      <p class="text-slate-600">Bienvenido a {title}.</p>
    </main>
  </body>
</html>
